# ============================================================
# PantauNegeri — Environment Variables (.env.example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database (MySQL 8.0 via aaPanel) ---
DATABASE_URL="mysql://pantau_user:CHANGE_ME@127.0.0.1:3306/pantaunegeri"

# --- Redis / Valkey (aaPanel or native Ubuntu) ---
REDIS_URL="redis://127.0.0.1:6379"
# Optional: Redis password if set
# REDIS_PASSWORD="CHANGE_ME"

# --- API Server ---
API_PORT=4000
API_HOST="0.0.0.0"
API_BASE_URL="https://pantaunegeri.id/api"

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="https://pantaunegeri.id/api"
NEXT_PUBLIC_APP_NAME="PantauNegeri"

# --- Nodemailer SMTP (Email Alerts) ---
SMTP_HOST="mail.pantaunegeri.id"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="noreply@pantaunegeri.id"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="PantauNegeri <noreply@pantaunegeri.id>"

# --- BPS Web API ---
BPS_API_KEY="CHANGE_ME"
BPS_API_BASE="https://webapi.bps.go.id/v1"

# --- Scraping / Ingestion Config ---
# Rate limit: 1 request per N ms per domain (default 4000 = 4 seconds)
SCRAPER_RATE_LIMIT_MS=4000
SCRAPER_USER_AGENT="PantauNegeri-Bot/1.0 (+https://pantaunegeri.id/bot)"
# Jeda antrean ulang katalog sumber (ms). Default 6 jam.
INGEST_INTERVAL_MS=21600000
# Daftar endpoint JSON pengadaan publik: KODE_LEMBAGA|https://url,KODE|https://url
INGEST_PROCUREMENT_ENDPOINTS=
# JSON publik { "value": number, "period_date": "YYYY-MM-DD" } bila tersedia tanpa autentikasi
BI_RATE_JSON_URL=
IKK_JSON_URL=
FOOD_INDEX_JSON_URL=
# Path relatif Web API BPS (tanpa key). Kosongkan bila belum diketahui.
# Contoh: /api/list/model/data/lang/ind/domain/0000/var/1/th/2024
BPS_INFLATION_PATH=

# --- OCR ---
# 'native' = use system tesseract-ocr CLI | 'js' = use tesseract.js
OCR_ENGINE="native"
TESSERACT_LANG="ind+eng"

# --- Anomaly Engine Thresholds ---
ANOMALY_PROC_HPS_DEVIATION_PCT=20
ANOMALY_OFFICIAL_WEALTH_JUMP_PCT=100
ANOMALY_MIN_RISK_NOTIFY="MEDIUM"

# --- Economic Score Thresholds ---
# USD/IDR rate considered "weakening"
ECO_USDIDR_WARN_THRESHOLD=16200
ECO_USDIDR_HIGH_THRESHOLD=17000
# Inflation YoY % considered "high"
ECO_INFLATION_WARN_THRESHOLD=4.0
ECO_INFLATION_HIGH_THRESHOLD=6.0
# BI Rate % considered "high"
ECO_BIRATE_HIGH_THRESHOLD=6.5

# --- JWT / Auth (admin dashboard) ---
JWT_SECRET="CHANGE_ME_min_32chars_random_string"
JWT_EXPIRES_IN="7d"

# --- Logging ---
LOG_LEVEL="info"
